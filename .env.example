# Safe only for isolated loopback demonstrations. Uvicorn does not load this
# file unless you pass --env-file. Copy to .env locally; NEVER commit .env.
COLDCHAIN_AUTH_MODE=demo
COLDCHAIN_DEMO_ROLE=admin
COLDCHAIN_TOKEN_TTL_SECONDS=3600
COLDCHAIN_TELEMETRY_STALE_SECONDS=900
COLDCHAIN_ALERT_ESCALATION_SECONDS=300
COLDCHAIN_WORKER_INTERVAL_SECONDS=5
COLDCHAIN_HIGH_TEMP_ALARM_C=6.0
COLDCHAIN_WEATHER_PROVIDER=deterministic
COLDCHAIN_WEATHER_LATITUDE=0
COLDCHAIN_WEATHER_LONGITUDE=0
COLDCHAIN_WEATHER_TIMEOUT_SECONDS=3
COLDCHAIN_WEATHER_CACHE_SECONDS=300

# For authenticated mode, replace the placeholders with LOCAL secrets and set
# AUTH_MODE=required. These are bootstrap credentials, not a password reset API.
# COLDCHAIN_DEMO_USERNAME=<your-admin-username>
# COLDCHAIN_DEMO_PASSWORD=<unique-password-at-least-12-characters>
# COLDCHAIN_SECRET_KEY=<random-secret-at-least-32-characters>
# COLDCHAIN_DB_PATH=<absolute-path-to-private-sqlite-database>

# Optional CodeFlow AI companion (OpenAI-compatible chat completions API).
# Leave these unset for an explicit "not configured" response.
# CODEFLOW_AI_API_KEY=<local-provider-key>
# CODEFLOW_AI_BASE_URL=https://api.openai.com/v1
# CODEFLOW_AI_MODEL=<model-name>
# CODEFLOW_AI_TIMEOUT_SECONDS=8
# CODEFLOW_EXECUTE_RATE_LIMIT_PER_MINUTE=120
# CODEFLOW_AI_RATE_LIMIT_PER_MINUTE=20

# Reproducible synthetic simulation and physics forecast settings.
# COLDCHAIN_SIMULATION_SEED=42
# COLDCHAIN_THERMAL_FORECAST_HORIZON_HOURS=6
